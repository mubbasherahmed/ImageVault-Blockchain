{
  "name": "image-vault-blockchain",
  "version": "1.0.0",
  "description": "Image-based smart contract system with hash IDs and key-based access control",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy": "npx hardhat ignition deploy ./ignition/modules/ImageVault.js --network localhost",
    "hash": "node scripts/hashImage.js --all",
    "interact": "npx hardhat run scripts/interact.js --network localhost"
  },
  "keywords": [
    "blockchain",
    "smart-contract",
    "image",
    "nft"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "dotenv": "^17.4.2",
    "hardhat": "^2.28.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
